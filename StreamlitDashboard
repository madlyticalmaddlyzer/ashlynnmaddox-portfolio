# Get Snowflake session
session = get_active_session()

# Helper function to format numbers with commas
def format_numbers(df, cols):
    for col in cols:
        df[col] = df[col].apply(lambda x: f"{int(x):,}" if pd.notnull(x) else "")
    return df

st.title("Amazon Warehouse Optimization Dashboard")

# 1. Top sites with the most costly jams
query1 = """
SELECT site_id, SUM(jam_costs) AS total_cost
FROM jams
GROUP BY site_id
ORDER BY total_cost DESC
LIMIT 60
"""
top_jams_df = session.sql(query1).to_pandas()
top_jams_df.columns = [col.lower() for col in top_jams_df.columns]

chart1 = alt.Chart(top_jams_df).mark_bar().encode(
    x=alt.X('site_id', sort='-y', title='Site ID'),
    y=alt.Y('total_cost', title='Total Jam Cost'),
    color=alt.Color('site_id', title='Site ID'),  
    tooltip=[
        alt.Tooltip('site_id', title='Site'),
        alt.Tooltip('total_cost', title='Total Cost', format=',')
    ]
).properties(width=700, height=400)

st.subheader("Top 10 Sites by Jam Cost")
st.altair_chart(chart1, use_container_width=True)



# 2. Repair types associated with highest jam costs
query2 = """
SELECT 
    rt.repair_type_name,
    SUM(j.jam_costs) AS total_jam_cost,
    AVG(rt.repair_cost) AS avg_repair_cost
FROM jams j
JOIN warehouse w ON j.site_id = w.site_name
JOIN repair_types rt ON w.repair_type_id = rt.repair_type_id
GROUP BY rt.repair_type_name
ORDER BY total_jam_cost DESC
LIMIT 10
"""
repair_costs_df = session.sql(query2).to_pandas()
repair_costs_df.columns = [col.lower() for col in repair_costs_df.columns]

chart2 = alt.Chart(repair_costs_df).mark_bar().encode(
    x=alt.X('repair_type_name', sort='-y', title='Repair Type'),
    y=alt.Y('total_jam_cost', title='Total Jam Cost'),
    color=alt.Color('repair_type_name', title='Repair Type'),
    tooltip=[
        alt.Tooltip('repair_type_name', title='Repair Type'),
        alt.Tooltip('total_jam_cost', title='Total Jam Cost', format=','),
        alt.Tooltip('avg_repair_cost', title='Avg Repair Cost', format=',.2f')
    ]
).properties(width=700, height=400)

st.subheader("Top Repair Types by Jam Cost")
st.altair_chart(chart2, use_container_width=True)


