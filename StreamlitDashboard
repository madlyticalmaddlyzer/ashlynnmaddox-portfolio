# 3. Maintenance schedules correlation with jams & costs
query3 = """
SELECT 
    pm.schedule_frequency,
    pm.maintenance_type,
    COUNT(j.site_id) AS number_of_jams,
    SUM(j.jam_costs) AS total_jam_cost,
    AVG(rt.repair_cost) AS avg_repair_cost
FROM jams j
JOIN warehouse w ON j.site_id = w.site_name
JOIN repair_types rt ON w.repair_type_id = rt.repair_type_id
JOIN pm_schedule pm ON rt.schedule_id = pm.schedule_id
GROUP BY pm.schedule_frequency, pm.maintenance_type
ORDER BY total_jam_cost ASC
LIMIT 10
"""
maint_df = session.sql(query3).to_pandas()
maint_df.columns = [col.lower() for col in maint_df.columns]

chart3 = alt.Chart(maint_df).mark_bar().encode(
    x=alt.X('maintenance_type', sort='-y', title='Maintenance Type'),
    y=alt.Y('total_jam_cost', title='Total Jam Cost'),
    tooltip=[
        alt.Tooltip('maintenance_type'),
        alt.Tooltip('schedule_frequency'),
        alt.Tooltip('number_of_jams', format=','),
        alt.Tooltip('total_jam_cost', format=','),
        alt.Tooltip('avg_repair_cost', format=',.2f')
    ]
).properties(width=700, height=400)

st.subheader("Maintenance Schedules Correlated with Lower Jam Costs")
st.altair_chart(chart3, use_container_width=True)




# 4. Weather impact on downtime and jams
query4 = """
SELECT
    wd.weather_type,
    SUM(wd.downtime_hours) AS total_downtime,
    SUM(j.jam_costs) AS total_jam_cost
FROM weather_disruptions wd
LEFT JOIN warehouse w ON w.region = wd.weather_disruption_id
LEFT JOIN jams j ON w.site_name = j.site_id
GROUP BY wd.weather_type
ORDER BY total_jam_cost DESC

"""
weather_df = session.sql(query4).to_pandas()
weather_df.columns = [col.lower() for col in weather_df.columns]

chart4 = alt.Chart(weather_df).mark_bar().encode(
    x=alt.X('weather_type', sort='-y', title='Weather Type'),
    y=alt.Y('total_jam_cost', title='Total Jam Cost'),
    color=alt.Color('weather_type', legend=None),
    tooltip=[
        alt.Tooltip('weather_type'),
        alt.Tooltip('total_downtime', format=','),
        alt.Tooltip('total_jam_cost', format=',')
    ]
).properties(width=700, height=400)

st.subheader("Top Weather Types by Total Jam Cost")
st.altair_chart(chart4, use_container_width=True)







# 5. Factors making jams more frequent or costly
query5 = """
SELECT
    w.region,
    w.equipment_type,
    w.automation_level,
    COUNT(j.site_id) AS jam_count,
    SUM(j.jam_costs) AS total_jam_cost
FROM warehouse w
JOIN jams j ON w.site_name = j.site_id
GROUP BY w.region, w.equipment_type, w.automation_level
ORDER BY total_jam_cost DESC
LIMIT 10
"""
factors_df = session.sql(query5).to_pandas()
factors_df.columns = [col.lower() for col in factors_df.columns]

chart5 = alt.Chart(factors_df).mark_bar().encode(
    x=alt.X('equipment_type', sort='-y', title='Equipment Type'),
    y=alt.Y('total_jam_cost', title='Total Jam Cost'),
    color='region',
    tooltip=[
        alt.Tooltip('region'),
        alt.Tooltip('equipment_type'),
        alt.Tooltip('automation_level'),
        alt.Tooltip('jam_count', format=','),
        alt.Tooltip('total_jam_cost', format=',')
    ]
).properties(width=700, height=400)

st.subheader("Factors Influencing Jam Frequency and Costs")
st.altair_chart(chart5, use_container_width=True)
